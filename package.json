{
  "name": "@speechmatics/ai-sdk-provider",
  "version": "0.2.0-beta.0",
  "description": "Speechmatics speech-to-text provider for the Vercel AI SDK",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speechmatics/speechmatics-ai-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/speechmatics/speechmatics-ai-sdk-provider/issues"
  },
  "homepage": "https://github.com/speechmatics/speechmatics-ai-sdk-provider#readme",
  "keywords": [
    "ai-sdk",
    "vercel",
    "speechmatics",
    "speech-to-text",
    "transcription"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "build:watch": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "test": "npm run test:node && npm run test:edge",
    "test:node": "vitest --config vitest.node.config.js --run",
    "test:edge": "vitest --config vitest.edge.config.js --run",
    "test:watch": "vitest --config vitest.node.config.js --watch",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@ai-sdk/provider-utils": "^5.0.82"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "zod": "3.25.76"
  }
}
